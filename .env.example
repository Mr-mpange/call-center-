# Africa's Talking credentials. Voice always uses the live Voice API.
AT_USERNAME=sandbox
AT_API_KEY=your_sandbox_api_key

# Server
PORT=3000
# Required for dashboard authentication. Use a random value of at least 32 characters.
AUTH_SECRET=replace-with-at-least-32-random-characters
# Dashboard API authentication is enabled by default. Set false only for isolated local development.
API_AUTH_REQUIRED=true
# Comma-separated existing account emails allowed to use platform-wide tenant switching.
PLATFORM_ADMIN_EMAILS=kilindosaid771@gmail.com
# SQLite transactional dashboard database. Set this to a persistent volume in deployment.
DASHBOARD_DB_FILE=./data/dashboard.sqlite
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
SERVICE_API_KEY=replace-with-at-least-32-random-characters
# Public API origin used when generating Africa's Talking webhook URLs.
PUBLIC_API_URL=https://api.example.com

# Provider adapters. Each provider is fail-closed until all required values are set.
RECORDING_BASE_URL=
RECORDING_SIGNING_SECRET=
TRANSCRIPTION_PROVIDER_URL=
TRANSCRIPTION_PROVIDER_KEY=
SUMMARY_PROVIDER_URL=
SUMMARY_PROVIDER_KEY=
# Google Gemini is used by the AI assistant and call summarization.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
BILLING_PROVIDER_URL=
BILLING_PROVIDER_KEY=
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_KEY=
AI_TRAINING_PROVIDER_URL=
AI_TRAINING_PROVIDER_KEY=
INTEGRATION_HEALTH_PROVIDER_URL=
INTEGRATION_HEALTH_PROVIDER_KEY=

# NileAGI/Rafiki integration (disabled by default).
# The official Rafiki API is documented at https://rafiki.nileagi.com/docs.
NILEAGI_ENABLED=false
NILEAGI_API_KEY=
NILEAGI_BASE_URL=https://api.rafiki.nileagi.com
NILEAGI_MODEL=
NILEAGI_TIMEOUT_MS=30000
NILEAGI_MAX_RETRIES=3
NILEAGI_LOG_LEVEL=info
NILEAGI_ADAPTER=rafiki-api
NILEAGI_STT_ENABLED=false
NILEAGI_TTS_ENABLED=false
NILEAGI_VOICE_ENABLED=false
NILEAGI_VOICE_TRANSPORT=http-turns
NILEAGI_MEDIA_GATEWAY_KEY=
NILEAGI_TEST_MODE=false
# Required only for the local-model adapter:
NILEAGI_STT_URL=
NILEAGI_TTS_URL=

# Optional
AT_FROM_SHORTCODE=12345
AT_SENDER_ID=
DEFAULT_RECIPIENT=

# USSD and Voice (for reference / testing)
AT_USSD_CODE=*384*123#
# Voice caller IDs are assigned per organization in the platform telephony inventory.
# Do not configure one global production caller ID here.
# Protect dashboard call-log endpoints with a long random secret.
VOICE_DASHBOARD_API_KEY=replace_with_a_long_random_secret
# Optional path for the append-only call event log (default: ./data/voice-events.jsonl).
VOICE_LOG_FILE=./data/voice-events.jsonl
# Optional path for dashboard IVR flow definitions (default: ./data/voice-ivr-flows.json).
VOICE_IVR_FILE=./data/voice-ivr-flows.json
# Business voice numbers and routing are managed per tenant in the backend,
# not through a shared environment variable.

AT_AIRTIME_CURRENCY=TZS

# WhatsApp (Africa's Talking)
AT_WHATSAPP_API_URL=
AT_WHATSAPP_SENDER=
AT_WHATSAPP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Asterisk ARI media gateway (local development / private PBX)
# ---------------------------------------------------------------------------
# Fail-closed by default. Set to asterisk only after the local gateway and ARI
# credentials are configured. ARI must never be exposed to the public internet.
MEDIA_BRIDGE_PROVIDER=
ASTERISK_ARI_URL=https://127.0.0.1:8089
ASTERISK_ARI_WS_URL=
ASTERISK_ARI_USERNAME=
ASTERISK_ARI_PASSWORD=
ASTERISK_ARI_APP=call-center
# Self-signed local certificate only. Set false behind a trusted TLS cert.
ASTERISK_ARI_INSECURE=true
ASTERISK_WSS_URL=wss://localhost:8089/ws
ASTERISK_SIP_DOMAIN=localhost
# Stasis contexts that are trusted to supply the called DID.
ASTERISK_INBOUND_CONTEXTS=from-test-sip,from-at-trunk,from-sip
# Local-only DID aliases (local test extension:tenant E.164 DID).
ASTERISK_TEST_DID_ALIASES=5551001:+255700000101
ASTERISK_LOCAL_TEST_CONTEXTS=from-test-sip
INBOUND_BROWSER_RING_TIMEOUT_MS=25000
ASTERISK_AGENT_REGISTRATION_WAIT_MS=6000
ASTERISK_AGENT_ORIGINATE_TIMEOUT_MS=15000
ASTERISK_MEDIA_READY_TIMEOUT_MS=20000
# Per-agent WSS endpoint provisioning. The backend writes only agent
# identities to this include and asks Asterisk to reload PJSIP.
SIP_CREDENTIAL_SECRET=replace-with-at-least-32-random-characters
SIP_AGENT_CREDENTIAL_TTL_SECONDS=28800
ASTERISK_PJSIP_PROVISIONING=file
ASTERISK_PJSIP_AGENTS_FILE=./infrastructure/asterisk/runtime/pjsip-agents.conf
# Local Docker CLI access is used for pjsip reload / RTP diagnostics.
ASTERISK_CLI_ENABLED=true
ASTERISK_CLI_BIN=docker
ASTERISK_CLI_DOCKER_CONTAINER=asterisk-asterisk-1
# Public deployment values must be supplied by the provider/operator:
# ASTERISK_PUBLIC_HOST=
# ASTERISK_PUBLIC_IP=
# ASTERISK_TLS_CERT_FILE=
# ASTERISK_TLS_KEY_FILE=
# AT_SIP_TRUNK_HOST=
# AT_SIP_SOURCE_CIDRS=
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=


[global]
type=global
user_agent=Mpange-Asterisk
endpoint_identifier_order=username,ip

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
allow_reload=no

[transport-wss]
type=transport
protocol=wss
bind=0.0.0.0
; Split-horizon media addressing. Browser agents run on the host machine and
; can only reach this container through Docker's loopback-published port
; mapping (127.0.0.1:10000-10100), while in-network SIP callers (SIPp, trunk)
; reach RTP directly on the container IP. Advertising 127.0.0.1 only on the
; WSS transport means each leg advertises an address its peer can actually
; route to; the UDP transport keeps the container address.
external_media_address=127.0.0.1

[sip-test-aor]
type=aor
max_contacts=1
remove_existing=yes

[sip-test]
type=endpoint
transport=transport-udp
context=from-test-sip
disallow=all
allow=ulaw,alaw
aors=sip-test-aor
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

; This identify rule applies only inside the isolated local Docker test subnet.
[sip-test-identify]
type=identify
endpoint=sip-test
match=172.29.0.0/24

; One isolated browser test endpoint. Production needs per-agent endpoint
; provisioning and short-lived credentials before this can be multi-tenant.
[${WEBRTC_AGENT_USERNAME}-auth]
type=auth
auth_type=userpass
username=${WEBRTC_AGENT_USERNAME}
password=${WEBRTC_AGENT_PASSWORD}

[${WEBRTC_AGENT_USERNAME}]
type=aor
max_contacts=2
remove_existing=yes

[${WEBRTC_AGENT_USERNAME}]
type=endpoint
transport=transport-wss
context=from-webrtc
disallow=all
allow=ulaw,alaw,opus
auth=${WEBRTC_AGENT_USERNAME}-auth
aors=${WEBRTC_AGENT_USERNAME}
webrtc=yes
dtls_auto_generate_cert=yes
media_encryption=dtls
ice_support=yes
rtcp_mux=yes
use_avpf=yes
media_use_received_transport=yes
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

; Per-agent browser WebRTC identities are generated by the backend at runtime.
; This file contains only agent identities, never trunk or ARI credentials.
#include runtime/pjsip-agents.conf
